# Copy this file to `.env.local` and fill in the values you have.
# `.env*` is gitignored — the real file never gets committed.
#
# Everything here is optional. With no keys at all, decoy generation serves
# pre-written content and the UI says so; nothing in the demo breaks.

# --- AI decoy generation -----------------------------------------------------
# Provider is chosen automatically: whichever key is present wins, Groq first.
# Set AI_PROVIDER to force one ("groq" | "anthropic" | "fallback").

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the model. Defaults to openai/gpt-oss-120b, which is one
# of the few Groq models that supports strict `json_schema` output — most,
# including llama-3.3-70b-versatile, reject it and fall back to plain JSON mode.
# GROQ_MODEL=openai/gpt-oss-120b

# Anthropic — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Force a provider regardless of which keys are set.
# AI_PROVIDER=groq

# --- Storage -----------------------------------------------------------------
# Optional. With both values set the platform persists to Supabase; without
# them it uses an in-memory store that resets when the process does.
#
# Required for any real deployment: on Vercel each route runs in its own
# container with its own memory, so without a shared database a decoy planted
# by one request is invisible to the next and share links appear to 404.
#
# Project Settings -> Data API -> Project URL
# SUPABASE_URL=https://<project-ref>.supabase.co
#
# Project Settings -> API Keys -> service_role. This key bypasses Row Level
# Security, so it must never reach the browser — it is read only in server
# routes, and no NEXT_PUBLIC_ prefix is used anywhere for it.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Operator authentication -------------------------------------------------
# Optional. Unset means the console is open, which is how the demo runs by
# default; /scope reports which of the two is in effect rather than leaving it
# to be discovered. Set this for any deployment reachable from the internet.
#
# One shared passphrase, not user accounts: this platform has a single
# operator role and no per-user data, so accounts would add a user table and a
# reset flow without changing who can see what. The session cookie is an HMAC
# over an expiry, signed with the passphrase, so rotating it signs everyone out.
#
# Decoy assets are deliberately NOT gated — /portal/login, /share/*,
# /api/track/* and /api/decoy/* stay public. A honeytoken behind a login can
# only be triggered by someone who already authenticated, which defeats it.
# OPERATOR_PASSPHRASE=

# --- Demo controls -----------------------------------------------------------
# The map carries a reset button that clears all events and incidents and
# restores the seed decoys. Set to "false" to disable the endpoint — it is
# unauthenticated and destructive, so anywhere that is not a demo should.
# ALLOW_DEMO_RESET=false

# --- SIEM / SOAR forwarding --------------------------------------------------
# When set, incidents POST an ECS-shaped payload here.
#
# Delivery is verified: run against a live HTTP receiver, which accepted a
# well-formed payload carrying every ECS field an indexer keys on. Index-time
# field mapping against a real Splunk/Sentinel/Elastic pipeline is NOT
# verified — say "it forwards", not "it integrates with Splunk".
#
# Prefer a local receiver over a public request bin: payloads carry department
# names and source addresses.
# SIEM_WEBHOOK_URL=http://127.0.0.1:4599/ingest
