# Copy this file to `.env.local` and fill in the values you have.
# `.env*` is gitignored — the real file never gets committed.
#
# Everything here is optional. With no keys at all, decoy generation serves
# pre-written content and the UI says so; nothing in the demo breaks.

# --- AI decoy generation -----------------------------------------------------
# Provider is chosen automatically: whichever key is present wins, Groq first.
# Set AI_PROVIDER to force one ("groq" | "anthropic" | "fallback").

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the model. Defaults to openai/gpt-oss-120b, which is one
# of the few Groq models that supports strict `json_schema` output — most,
# including llama-3.3-70b-versatile, reject it and fall back to plain JSON mode.
# GROQ_MODEL=openai/gpt-oss-120b

# Anthropic — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Force a provider regardless of which keys are set.
# AI_PROVIDER=groq

# --- SIEM / SOAR forwarding --------------------------------------------------
# When set, incidents POST an ECS-shaped payload here.
#
# Delivery is verified: run against a live HTTP receiver, which accepted a
# well-formed payload carrying every ECS field an indexer keys on. Index-time
# field mapping against a real Splunk/Sentinel/Elastic pipeline is NOT
# verified — say "it forwards", not "it integrates with Splunk".
#
# Prefer a local receiver over a public request bin: payloads carry department
# names and source addresses.
# SIEM_WEBHOOK_URL=http://127.0.0.1:4599/ingest
